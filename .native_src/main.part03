,x.supplierName,money(x.total),money(x.paid),money(x.due),x.status]).toList();
    }else if(kind=='المخزون'){
      headers=['SKU','المنتج','الفئة','الكمية','التكلفة','سعر البيع','القيمة'];
      rows=products.map((x)=>[x.sku,x.name,x.category,money(x.stock),money(x.cost),money(x.price),money(x.stock*x.cost)]).toList();
    }else if(kind=='العملاء والموردون'){
      headers=['النوع','الاسم','الهاتف','الرصيد'];
      rows=contacts.map((x)=>[x.type,x.name,x.phone,money(x.balance)]).toList();
    }else if(kind=='المصروفات'){
      headers=['التاريخ','التصنيف','البيان','المبلغ'];
      rows=expenses.map((x)=>[dateText(x.date),x.category,x.note,money(x.amount)]).toList();
    }else if(kind=='اليومية'){
      headers=['التاريخ','المرجع','البيان','الحساب','مدين','دائن'];
      for(final x in journals){for(final l in x.lines)rows.add([dateText(x.date),x.ref,x.note,l.account,money(l.debit),money(l.credit)]);}
    }else if(kind=='ميزان المراجعة'){
      headers=['الحساب','إجمالي المدين','إجمالي الدائن','الرصيد'];
      final totals=<String,List<double>>{};
      for(final j in journals){for(final l in j.lines){final t=totals.putIfAbsent(l.account,()=>[0,0]);t[0]+=l.debit;t[1]+=l.credit;}}
      final names=totals.keys.toList()..sort();
      rows=names.map((name){final t=totals[name]!;return [name,money(t[0]),money(t[1]),money(t[0]-t[1])];}).toList();
    }else if(kind=='الخزائن والبنوك'){
      headers=['الحساب','النوع','الرصيد'];
      rows=cashAccounts.map((x)=>[x.name,x.type,money(x.balance)]).toList();
    }else{
      title='التقرير المالي الشامل';
      headers=['المؤشر','القيمة'];
      rows=[['إجمالي المبيعات',money(salesTotal)],['إجمالي المشتريات',money(purchasesTotal)],['تكلفة البضاعة المباعة',money(cogs)],['مجمل الربح',money(grossProfit)],['المصروفات',money(expenseTotal)],['صافي الربح',money(netProfit)],['النقدية والبنوك',money(cashTotal)],['مستحقات العملاء',money(receivables)],['مستحقات الموردين',money(payables)],['قيمة المخزون',money(inventoryValue)]];
    }
    final pdfHeaders=headers.reversed.toList();
    final pdfRows=rows.map((r)=>r.reversed.toList()).toList();
    doc.addPage(pw.MultiPage(
      pageFormat:PdfPageFormat.a4,
      textDirection:pw.TextDirection.rtl,
      theme:pw.ThemeData.withFont(base:font,bold:bold),
      margin:const pw.EdgeInsets.fromLTRB(24,26,24,28),
      header:(ctx)=>pw.Container(
        width:double.infinity,padding:const pw.EdgeInsets.symmetric(horizontal:14,vertical:12),
        decoration:pw.BoxDecoration(color:PdfColor.fromHex('#F0F4FF'),border:pw.Border.all(color:PdfColor.fromHex('#D9E3F7')),borderRadius:pw.BorderRadius.circular(10)),
        child:pw.Column(crossAxisAlignment:pw.CrossAxisAlignment.end,children:[
          pw.Text(companyName,textDirection:pw.TextDirection.rtl,textAlign:pw.TextAlign.right,style:pw.TextStyle(font:bold,fontSize:14,color:PdfColor.fromHex('#0B163F'))),
          pw.SizedBox(height:3),
          pw.Text(title,textDirection:pw.TextDirection.rtl,textAlign:pw.TextAlign.right,style:pw.TextStyle(font:bold,fontSize:20,color:PdfColor.fromHex('#12224B'))),
          pw.SizedBox(height:4),
          pw.Text('الفترة: السنة المالية $fiscalYear   •   الفرع: $branch   •   العملة: $currency   •   تاريخ الطباعة: ${dateText(DateTime.now())}',textDirection:pw.TextDirection.rtl,textAlign:pw.TextAlign.right,style:pw.TextStyle(font:font,fontSize:8.5,color:PdfColors.grey700)),
        ]),
      ),
      footer:(ctx)=>pw.Container(alignment:pw.Alignment.center,padding:const pw.EdgeInsets.only(top:8),child:pw.Text('حساباتي   •   صفحة ${ctx.pageNumber} من ${ctx.pagesCount}',textDirection:pw.TextDirection.rtl,style:pw.TextStyle(font:font,fontSize:8,color:PdfColors.grey600))),
      build:(ctx)=>[
        pw.SizedBox(height:12),
        if(pdfRows.isEmpty)pw.Container(
          width:double.infinity,padding:const pw.EdgeInsets.all(22),
          decoration:pw.BoxDecoration(color:PdfColor.fromHex('#F8FAFC'),border:pw.Border.all(color:PdfColor.fromHex('#E5E7EB'))),
          child:pw.Text('لا توجد بيانات ضمن هذا التقرير.',textDirection:pw.TextDirection.rtl,textAlign:pw.TextAlign.center,style:pw.TextStyle(font:bold,fontSize:12))
        ) else pw.TableHelper.fromTextArray(
          headers:pdfHeaders,data:pdfRows,
          headerStyle:pw.TextStyle(font:bold,color:PdfColors.white,fontSize:8.5),
          headerDecoration:pw.BoxDecoration(color:PdfColor.fromHex('#12224B')),
          cellStyle:pw.TextStyle(font:font,fontSize:8.2,color:PdfColor.fromHex('#1F2937')),
          cellAlignment:pw.Alignment.centerRight,
          oddRowDecoration:pw.BoxDecoration(color:PdfColor.fromHex('#F7F9FC')),
          border:pw.TableBorder.all(color:PdfColor.fromHex('#D9E0EA'),width:.45),
          cellPadding:const pw.EdgeInsets.symmetric(horizontal:5,vertical:6),
        ),
        pw.SizedBox(height:10),
        pw.Align(alignment:pw.Alignment.centerRight,child:pw.Text('عدد السجلات: ${rows.length}',textDirection:pw.TextDirection.rtl,style:pw.TextStyle(font:font,fontSize:8,color:PdfColors.grey700)))
      ]
    ));
    await Printing.sharePdf(bytes:await doc.save(),filename:'hesabati_${kind.replaceAll(RegExp(r'[^a-zA-Z0-9_\-]'),'_')}.pdf');
  }
}


class HesabatiApp extends StatefulWidget {
  const HesabatiApp({super.key});
  @override State<HesabatiApp> createState()=>_HesabatiAppState();
}
class _HesabatiAppState extends State<HesabatiApp>{
  final store=HesabatiStore();
  @override void initState(){super.initState();store.init();}
  @override Widget build(BuildContext context){
    return AnimatedBuilder(animation:store,builder:(context,_){
      const navy=Color(0xFF0B163F),blue=Color(0xFF2563EB),bg=Color(0xFFF5F7FC);
      return MaterialApp(
        debugShowCheckedModeBanner:false,locale:const Locale('ar'),title:'حساباتي',
        theme:ThemeData(
          useMaterial3:true,fontFamily:'sans-serif',scaffoldBackgroundColor:bg,
          colorScheme:ColorScheme.fromSeed(seedColor:blue,primary:blue,secondary:const Color(0xFF06B6D4),surface:Colors.white),
          cardTheme:CardThemeData(elevation:0,margin:EdgeInsets.zero,color:Colors.white,shape:RoundedRectangleBorder(borderRadius:BorderRadius.circular(22),side:const BorderSide(color:Color(0xFFE8ECF4)))),
          appBarTheme:const AppBarTheme(backgroundColor:bg,foregroundColor:navy,elevation:0,scrolledUnderElevation:0),
          inputDecorationTheme:InputDecorationTheme(
            filled:true,fillColor:Colors.white,
            border:OutlineInputBorder(borderRadius:BorderRadius.circular(16),borderSide:const BorderSide(color:Color(0xFFE1E7F0))),
            enabledBorder:OutlineInputBorder(borderRadius:BorderRadius.circular(16),borderSide:const BorderSide(color:Color(0xFFE1E7F0))),
            focusedBorder:OutlineInputBorder(borderRadius:BorderRadius.circular(16),borderSide:const BorderSide(color:blue,width:1.5)),
            contentPadding:const EdgeInsets.symmetric(horizontal:15,vertical:14)
          ),
          filledButtonTheme:FilledButtonThemeData(style:FilledButton.styleFrom(shape:RoundedRectangleBorder(borderRadius:BorderRadius.circular(15)),padding:const EdgeInsets.symmetric(horizontal:18,vertical:14))),
          navigationBarTheme:NavigationBarThemeData(
            height:72,backgroundColor:Colors.white,indicatorColor:const Color(0xFFE8F0FF),
            labelTextStyle:WidgetStateProperty.resolveWith((states)=>TextStyle(fontWeight:states.contains(WidgetState.selected)?FontWeight.w800:FontWeight.w600,fontSize:11,color:states.contains(WidgetState.selected)?blue:const Color(0xFF7A849A)))
          )
        ),
        home:store.startupError!=null?Scaffold(body:Center(child:Padding(padding:const EdgeInsets.all(24),child:Column(mainAxisSize:MainAxisSize.min,children:[const Icon(Icons.error_outline,size:48,color:Colors.red),const SizedBox(height:12),const Text('تعذر بدء تشغيل حساباتي',style:TextStyle(fontSize:20,fontWeight:FontWeight.bold)),const SizedBox(height:10),Text(store.startupError!,textAlign:TextAlign.center),const SizedBox(height:12),const Text('لم يتم حذف بياناتك. أرسل صورة هذه الرسالة للدعم.',textAlign:TextAlign.center)])))):store.ready?HomeShell(store:store):const Scaffold(body:Center(child:CircularProgressIndicator())),
      );
    });
  }
}
enum Section { dashboard,sales,purchases,contacts,inventory,accounting,cash,expenses,reports,settings }

class HomeShell extends StatefulWidget{
  final HesabatiStore store; const HomeShell({super.key,required this.store});
  @override State<HomeShell> createState()=>_HomeShellState();
}
class _HomeShellState extends State<HomeShell>{
  Section section=Section.dashboard;
  final scaffoldKey=GlobalKey<ScaffoldState>();
  static const navy=Color(0xFF0B163F),blue=Color(0xFF2563EB),muted=Color(0xFF7A849A);
  final labels={
    Section.dashboard:'الرئيسية',Section.sales:'المبيعات',Section.purchases:'المشتريات',Section.contacts:'العملاء والموردون',
    Section.inventory:'المنتجات والمخزون',Section.accounting:'المحاسبة',Section.cash:'الخزائن والبنوك',
    Section.expenses:'المصروفات',Section.reports:'التقارير',Section.settings:'الإعدادات'
  };
  final icons={
    Section.dashboard:Icons.space_dashboard_rounded,Section.sales:Icons.receipt_long_rounded,Section.purchases:Icons.local_shipping_rounded,Section.contacts:Icons.people_alt_rounded,
    Section.inventory:Icons.inventory_2_rounded,Section.accounting:Icons.account_balance_wallet_rounded,Section.cash:Icons.account_balance_rounded,
    Section.expenses:Icons.payments_rounded,Section.reports:Icons.analytics_rounded,Section.settings:Icons.settings_rounded
  };
  int primaryIndex(){if(section==Section.dashboard)return 0;if(section==Section.sales)return 1;if(section==Section.reports)return 2;return 3;}
  @override Widget build(BuildContext context){
    final s=widget.store;
    final body=switch(section){
      Section.dashboard=>DashboardScreen(store:s,onGo:(x)=>setState(()=>section=x)),
      Section.sales=>SalesScreen(store:s),Section.purchases=>PurchasesScreen(store:s),Section.contacts=>ContactsScreen(store:s),
      Section.inventory=>InventoryScreen(store:s),Section.accounting=>AccountingScreen(store:s),
      Section.cash=>CashScreen(store:s),Section.expenses=>ExpensesScreen(store:s),Section.reports=>ReportsScreen(store:s),Section.settings=>SettingsScreen(store:s),
    };
    return Directionality(textDirection:TextDirection.rtl,child:Scaffold(
      key:scaffoldKey,
      appBar:AppBar(
        toolbarHeight:72,
        leading:IconButton(onPressed:()=>scaffoldKey.currentState?.openDrawer(),icon:const Icon(Icons.menu_rounded)),
        title:Column(crossAxisAlignment:CrossAxisAlignment.start,children:[
          Text(labels[section]!,style:const TextStyle(fontWeight:FontWeight.w900,fontSize:20,color:navy)),
          const SizedBox(height:2),Text('${s.companyName}  •  ${s.branch}',style:const TextStyle(fontSize:10.5,color:muted,fontWeight:FontWeight.w600))
        ]),
        actions:[if(section!=Section.settings)IconButton(onPressed:()=>setState(()=>section=Section.settings),icon:const Icon(Icons.tune_rounded)),const SizedBox(width:6)]
      ),
      drawer:Drawer(backgroundColor:Colors.white,child:SafeArea(child:Column(children:[
        Container(
          width:double.infinity,margin:const EdgeInsets.all(12),padding:const EdgeInsets.all(18),
          decoration:BoxDecoration(gradient:const LinearGradient(colors:[navy,Color(0xFF183C8A)],begin:Alignment.topRight,end:Alignment.bottomLeft),borderRadius:BorderRadius.circular(24)),
          child:Row(children:[
            Container(width:52,height:52,decoration:BoxDecoration(color:Colors.white.withOpacity(.14),borderRadius:BorderRadius.circular(16)),child:const Icon(Icons.account_balance_wallet_rounded,color:Colors.white,size:28)),
            const SizedBox(width:12),
            const Expanded(child:Column(crossAxisAlignment:CrossAxisAlignment.start,children:[
              Text('حساباتي',style:TextStyle(color:Colors.white,fontSize:24,fontWeight:FontWeight.w900)),
              Text('إدارة أعمال ومحاسبة متكاملة',style:TextStyle(color:Color(0xFFC7D7FF),fontSize:10.5,fontWeight:FontWeight.w600))
            ]))
          ])
        ),
        Expanded(child:ListView(padding:const EdgeInsets.symmetric(horizontal:10),children:Section.values.map((e){
          final selected=section==e;
          return Padding(padding:const EdgeInsets.only(bottom:4),child:ListTile(
            leading:Icon(icons[e],color:selected?blue:muted),
            title:Text(labels[e]!,style:TextStyle(fontWeight:selected?FontWeight.w800:FontWeight.w600,color:selected?navy:const Color(0xFF4B5568))),
            selected:selected,selectedTileColor:const Color(0xFFEFF4FF),shape:RoundedRectangleBorder(borderRadius:BorderRadius.circular(14)),
            onTap:(){Navigator.pop(context);setState(()=>section=e);}
          ));
        }).toList())),
        const Padding(padding:EdgeInsets.all(14),child:Row(mainAxisAlignment:MainAxisAlignment.center,children:[
          Icon(Icons.offline_bolt_rounded,size:14,color:Color(0xFF16A34A)),SizedBox(width:5),
          Text('يعمل محليًا • بياناتك على جهازك',style:TextStyle(fontSize:10,color:muted,fontWeight:FontWeight.w600))
        ]))
      ]))),
      body:AnimatedSwitcher(duration:const Duration(milliseconds:180),child:KeyedSubtree(key:ValueKey(section),child:body)),
      bottomNavigationBar:NavigationBar(
        selectedIndex:primaryIndex(),
        onDestinationSelected:(i){
          if(i==0)setState(()=>section=Section.dashboard);if(i==1)setState(()=>section=Section.sales);if(i==2)setState(()=>section=Section.reports);if(i==3)scaffoldKey.currentState?.openDrawer();
        },
        destinations:const [
          NavigationDestination(icon:Icon(Icons.space_dashboard_outlined),selectedIcon:Icon(Icons.space_dashboard_rounded),label:'الرئيسية'),
          NavigationDestination(icon:Icon(Icons.receipt_long_outlined),selectedIcon:Icon(Icons.receipt_long_rounded),label:'المبيعات'),
          NavigationDestination(icon:Icon(Icons.analytics_outlined),selectedIcon:Icon(Icons.analytics_rounded),label:'التقارير'),
          NavigationDestination(icon:Icon(Icons.apps_rounded),label:'المزيد')
        ]
