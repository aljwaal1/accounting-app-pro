      )
    ));
  }
}

class DashboardScreen extends StatelessWidget{
  final HesabatiStore store;final void Function(Section) onGo;
  const DashboardScreen({super.key,required this.store,required this.onGo});
  static const navy=Color(0xFF0B163F),blue=Color(0xFF2563EB),muted=Color(0xFF7A849A);
  @override Widget build(BuildContext context){
    final low=store.products.where((p)=>p.stock<=p.minStock).toList();
    return ListView(padding:const EdgeInsets.fromLTRB(14,6,14,20),children:[
      Container(
        padding:const EdgeInsets.all(20),
        decoration:BoxDecoration(gradient:const LinearGradient(colors:[navy,Color(0xFF1E4AA8)],begin:Alignment.topRight,end:Alignment.bottomLeft),borderRadius:BorderRadius.circular(28),boxShadow:[BoxShadow(color:navy.withOpacity(.16),blurRadius:26,offset:const Offset(0,12))]),
        child:Column(crossAxisAlignment:CrossAxisAlignment.start,children:[
          Row(children:[
            Container(padding:const EdgeInsets.all(10),decoration:BoxDecoration(color:Colors.white.withOpacity(.12),borderRadius:BorderRadius.circular(15)),child:const Icon(Icons.insights_rounded,color:Colors.white)),
            const SizedBox(width:10),
            const Expanded(child:Column(crossAxisAlignment:CrossAxisAlignment.start,children:[Text('ملخص الأداء',style:TextStyle(color:Color(0xFFBFD0FF),fontSize:11,fontWeight:FontWeight.w700)),Text('صافي نتيجة النشاط',style:TextStyle(color:Colors.white,fontSize:15,fontWeight:FontWeight.w800))])),
            Container(padding:const EdgeInsets.symmetric(horizontal:10,vertical:6),decoration:BoxDecoration(color:Colors.white.withOpacity(.10),borderRadius:BorderRadius.circular(12)),child:Text(store.netProfit>=0?'ربح':'خسارة',style:const TextStyle(color:Colors.white,fontSize:11,fontWeight:FontWeight.w800)))
          ]),
          const SizedBox(height:18),
          Text('${money(store.netProfit)} ${store.currency}',style:const TextStyle(color:Colors.white,fontSize:30,fontWeight:FontWeight.w900,letterSpacing:.2)),
          const SizedBox(height:15),
          Row(children:[
            Expanded(child:_heroMini('المبيعات',store.salesTotal,Icons.arrow_upward_rounded,const Color(0xFF63E6BE))),
            Container(width:1,height:42,color:Colors.white.withOpacity(.14)),
            Expanded(child:_heroMini('المصروفات',store.expenseTotal,Icons.arrow_downward_rounded,const Color(0xFFFFB4B4)))
          ])
        ])
      ),
      const SizedBox(height:16),const _SectionTitle('نظرة سريعة','الأرقام الأهم في عملك'),const SizedBox(height:10),
      GridView.count(shrinkWrap:true,physics:const NeverScrollableScrollPhysics(),crossAxisCount:2,crossAxisSpacing:10,mainAxisSpacing:10,childAspectRatio:1.48,children:[
        ProKpi('النقدية والبنوك',store.cashTotal,Icons.account_balance_rounded,const Color(0xFF2563EB),store.currency),
        ProKpi('قيمة المخزون',store.inventoryValue,Icons.inventory_2_rounded,const Color(0xFFF59E0B),store.currency),
        ProKpi('مستحقات العملاء',store.receivables,Icons.call_received_rounded,const Color(0xFF8B5CF6),store.currency),
        ProKpi('مستحقات الموردين',store.payables,Icons.call_made_rounded,const Color(0xFFEF4444),store.currency),
      ]),
      const SizedBox(height:18),const _SectionTitle('إجراء سريع','ابدأ العملية بضغطة واحدة'),const SizedBox(height:10),
      SizedBox(height:112,child:ListView(scrollDirection:Axis.horizontal,children:[
        _quick('فاتورة بيع',Icons.add_shopping_cart_rounded,blue,()=>onGo(Section.sales)),
        _quick('فاتورة شراء',Icons.local_shipping_rounded,const Color(0xFF8B5CF6),()=>onGo(Section.purchases)),
        _quick('منتج',Icons.inventory_2_rounded,const Color(0xFFF59E0B),()=>onGo(Section.inventory)),
        _quick('عميل / مورد',Icons.person_add_alt_1_rounded,const Color(0xFF16A34A),()=>onGo(Section.contacts)),
      ])),
      const SizedBox(height:18),
      Card(child:Padding(padding:const EdgeInsets.all(16),child:Column(crossAxisAlignment:CrossAxisAlignment.start,children:[
        const _SectionTitle('المؤشرات المالية','تحديث مباشر من العمليات'),const SizedBox(height:12),
        MetricRow('مجمل الربح',store.grossProfit,store.currency,const Color(0xFF16A34A)),const Divider(height:18),
        MetricRow('تكلفة البضاعة المباعة',store.cogs,store.currency,const Color(0xFF8B5CF6)),const Divider(height:18),
        MetricRow('إجمالي المشتريات',store.purchasesTotal,store.currency,const Color(0xFF2563EB)),
      ]))),
      const SizedBox(height:18),
      Row(mainAxisAlignment:MainAxisAlignment.spaceBetween,children:[
        const _SectionTitle('تنبيهات المخزون','الأصناف التي تحتاج متابعة'),
        if(low.isNotEmpty)Container(padding:const EdgeInsets.symmetric(horizontal:9,vertical:4),decoration:BoxDecoration(color:const Color(0xFFFFEAEA),borderRadius:BorderRadius.circular(10)),child:Text('${low.length}',style:const TextStyle(color:Color(0xFFDC2626),fontWeight:FontWeight.w900)))
      ]),const SizedBox(height:8),
      if(low.isEmpty)Container(padding:const EdgeInsets.all(18),decoration:BoxDecoration(color:const Color(0xFFF0FDF4),borderRadius:BorderRadius.circular(18)),child:const Row(children:[Icon(Icons.check_circle_rounded,color:Color(0xFF16A34A)),SizedBox(width:9),Expanded(child:Text('مستويات المخزون جيدة حاليًا',style:TextStyle(fontWeight:FontWeight.w700,color:Color(0xFF166534))))]))
      else ...low.take(4).map((p)=>Card(child:ListTile(
        contentPadding:const EdgeInsets.symmetric(horizontal:14,vertical:4),
        leading:Container(width:42,height:42,decoration:BoxDecoration(color:const Color(0xFFFFF4E5),borderRadius:BorderRadius.circular(13)),child:const Icon(Icons.warning_amber_rounded,color:Color(0xFFF59E0B))),
        title:Text(p.name,style:const TextStyle(fontWeight:FontWeight.w800,color:navy)),
        subtitle:Text('المتاح ${money(p.stock)}  •  الحد الأدنى ${money(p.minStock)}',style:const TextStyle(fontSize:11,color:muted)),
        trailing:const Icon(Icons.chevron_left_rounded,color:muted)
      )))
    ]);
  }
  Widget _heroMini(String t,double v,IconData i,Color c)=>Padding(padding:const EdgeInsets.symmetric(horizontal:10),child:Row(children:[
    Container(padding:const EdgeInsets.all(6),decoration:BoxDecoration(color:c.withOpacity(.13),shape:BoxShape.circle),child:Icon(i,size:15,color:c)),const SizedBox(width:8),
    Expanded(child:Column(crossAxisAlignment:CrossAxisAlignment.start,children:[Text(t,style:const TextStyle(color:Color(0xFFBFD0FF),fontSize:10)),FittedBox(child:Text('${money(v)} ${store.currency}',style:const TextStyle(color:Colors.white,fontWeight:FontWeight.w800,fontSize:13))) ]))
  ]));
  Widget _quick(String t,IconData i,Color c,VoidCallback onTap)=>Padding(padding:const EdgeInsets.only(left:9),child:InkWell(borderRadius:BorderRadius.circular(20),onTap:onTap,child:Container(
    width:108,padding:const EdgeInsets.all(13),decoration:BoxDecoration(color:Colors.white,borderRadius:BorderRadius.circular(20),border:Border.all(color:const Color(0xFFE8ECF4))),
    child:Column(crossAxisAlignment:CrossAxisAlignment.start,mainAxisAlignment:MainAxisAlignment.spaceBetween,children:[
      Container(width:40,height:40,decoration:BoxDecoration(color:c.withOpacity(.10),borderRadius:BorderRadius.circular(13)),child:Icon(i,color:c,size:21)),
      Text(t,maxLines:2,style:const TextStyle(color:navy,fontWeight:FontWeight.w800,fontSize:12))
    ])
  )));
}
class _SectionTitle extends StatelessWidget{
  final String title,subtitle;const _SectionTitle(this.title,this.subtitle,{super.key});
  @override Widget build(BuildContext context)=>Column(crossAxisAlignment:CrossAxisAlignment.start,children:[
    Text(title,style:const TextStyle(color:Color(0xFF0B163F),fontSize:16,fontWeight:FontWeight.w900)),const SizedBox(height:2),
    Text(subtitle,style:const TextStyle(color:Color(0xFF8B94A7),fontSize:10.5,fontWeight:FontWeight.w500))
  ]);
}
class ProKpi extends StatelessWidget{
  final String title,currency;final double value;final IconData icon;final Color color;const ProKpi(this.title,this.value,this.icon,this.color,this.currency,{super.key});
  @override Widget build(BuildContext c)=>Card(child:Padding(padding:const EdgeInsets.all(14),child:Column(crossAxisAlignment:CrossAxisAlignment.start,mainAxisAlignment:MainAxisAlignment.spaceBetween,children:[
    Row(children:[Container(width:36,height:36,decoration:BoxDecoration(color:color.withOpacity(.10),borderRadius:BorderRadius.circular(12)),child:Icon(icon,color:color,size:19)),const Spacer(),const Icon(Icons.more_horiz_rounded,color:Color(0xFFB2BAC8),size:18)]),
    const SizedBox(height:8),Text(title,style:const TextStyle(color:Color(0xFF7A849A),fontSize:10.5,fontWeight:FontWeight.w700)),const SizedBox(height:2),
    FittedBox(child:Text('${money(value)} $currency',style:const TextStyle(color:Color(0xFF0B163F),fontSize:18,fontWeight:FontWeight.w900)))
  ])));
}
class Kpi extends StatelessWidget{
  final String title,currency;final double value;final IconData icon;final Color color;
  const Kpi(this.title,this.value,this.icon,this.color,this.currency,{super.key});
  @override Widget build(BuildContext context)=>ProKpi(title,value,icon,color,currency);
}
class MetricRow extends StatelessWidget{
  final String t,c;final double v;final Color color;const MetricRow(this.t,this.v,this.c,this.color,{super.key});
  @override Widget build(BuildContext context)=>Row(children:[
    Container(width:7,height:7,decoration:BoxDecoration(color:color,shape:BoxShape.circle)),const SizedBox(width:8),
    Expanded(child:Text(t,style:const TextStyle(color:Color(0xFF5B6475),fontWeight:FontWeight.w600,fontSize:12))),
    Text('${money(v)} $c',style:TextStyle(fontWeight:FontWeight.w900,color:color,fontSize:13))
  ]);
}
class SalesScreen extends StatelessWidget{
  final HesabatiStore store;const SalesScreen({super.key,required this.store});
  @override Widget build(BuildContext context)=>ListView(padding:const EdgeInsets.all(14),children:[
    Row(children:[Expanded(child:FilledButton.icon(onPressed:()=>Navigator.push(context,MaterialPageRoute(builder:(_)=>SaleForm(store:store))),icon:const Icon(Icons.add),label:const Text('فاتورة بيع جديدة'))),const SizedBox(width:8),IconButton.filledTonal(onPressed:()=>store.exportPdfReport('المبيعات'),icon:const Icon(Icons.picture_as_pdf))]),
    const SizedBox(height:12),
    ...store.sales.map((x)=>Card(child:ListTile(
      leading:CircleAvatar(child:Text(x.id.split('-').last)),
      title:Text(x.customerName),subtitle:Text('${x.id} • ${dateText(x.date)}\n${x.status}'),
      trailing:Column(mainAxisAlignment:MainAxisAlignment.center,crossAxisAlignment:CrossAxisAlignment.end,children:[Text('${money(x.total)} ${store.currency}',style:const TextStyle(fontWeight:FontWeight.bold)),if(x.due>0)Text('متبقي ${money(x.due)}',style:const TextStyle(color:Colors.red,fontSize:11))]),
      onTap:x.due>0?()=>showReceiveDialog(context,store,x):null
    ))),
    if(store.sales.isEmpty)const EmptyBox('لا توجد فواتير مبيعات بعد')
  ]);
}

