  final cat=TextEditingController(),note=TextEditingController(),amount=TextEditingController();String aid=store.cashAccounts.first.id;
  showDialog(context:context,builder:(ctx)=>AlertDialog(title:const Text('تسجيل مصروف'),content:Column(mainAxisSize:MainAxisSize.min,children:[
    TextField(controller:cat,decoration:const InputDecoration(labelText:'التصنيف')),const SizedBox(height:8),TextField(controller:note,decoratio