y,required this.store});
  @override Widget build(BuildContext context){
    double td=0,tc=0;for(final j in store.journals){for(final l in j.lines){td+=l.debit;tc+=l.credit;}}
    return ListView(padding:const EdgeInsets.all(14),children:[
      GridView.count(shrinkWrap:true,physics:const NeverScrollableScrollPhysics(),crossAxisCount:2,crossAxisSpacing:8,mainAxisSpacing:8,childAspectRatio:1.5,children:[
        Kpi('إجمالي المدين',td,Icons.arrow_downward,Colors.red,store.currency),Kpi('إجمالي الدائن',tc,Icons.arrow_upward,Colors.green,store.currency)
      ]),
      const SizedBox(height:12),
      Row(children:[Expanded(child:FilledButton.icon(onPressed:()=>manualJournalDialog(context,store),icon:const Icon(Icons.add),label:const Text('قيد يومية يدوي'))),const SizedBox(width:8),IconButton.filledTonal(onPressed:()=>store.exportPdfReport('اليومية'),icon:const Icon(Icons.picture_as_pdf))]),
      const SizedBox(height:12),
      ...store.journals.map((j)=>Card(child:ExpansionTile(title:Text(j.note),subtitle:Text('${j.ref} • ${dateText(j.date)}'),children:j.lines.map((l)=>ListTile(dense:true,title:Text(l.account),trailing:Text('مدين ${money(l.debit)}   |   دائن ${money(l.credit)}'))).toList())))
    ]);
  }
}
void manualJournalDialog(BuildContext context,HesabatiStore store){
  final note=TextEditingController(),debitAcc=TextEditingController(),creditAcc=TextEditingController(),amount=TextEditingController();
  final accounts=<String>{
    'الصندوق','البنك','العملاء','الموردون','المخزون','حقوق الملكية',
    ...store.cashAccounts.map((a)=>a.name),
    ...store.journals.expand((j)=>j.lines.map((l)=>l.account)),
  }.toList()..sort();
  showDialog(context:context,builder:(ctx)=>StatefulBuilder(builder:(ctx,setState){
    final value=dval(amount.text);
    final valid=value.isFinite && value>0 && debitAcc.text.trim().isNotEmpty &&
        creditAcc.text.trim().isNotEmpty && debitAcc.text.trim()!=creditAcc.text.trim();
    Widget accountField(TextEditingController controller,String label)=>Column(
      crossAxisAlignment:CrossAxisAlignment.stretch,children:[
        TextField(controller:controller,onChanged:(_)=>setState((){}),decoration:InputDecoration(labelText:label)),
        if(accounts.isNotEmpty)SizedBox(height:44,child:ListView(scrollDirection:Axis.horizontal,children:accounts.map((name)=>
          Padding(padding:const EdgeInsetsDirectional.only(end:5),child:ActionChip(label:Text(name),onPressed:(){
            controller.text=name;setState((){});
          }))).toList())),
      ]);
    return AlertDialog(
      title:const Text('قيد يومية يدوي'),
      content:SingleChildScrollView(child:Column(mainAxisSize:MainAxisSize.min,children:[
        TextField(controller:note,decoration:const InputDecoration(labelText:'البيان')),
        const SizedBox(height:10),
        accountField(debitAcc,'الحساب المدين'),
        const SizedBox(height:10),
        accountField(creditAcc,'الحساب الدائن'),
        const SizedBox(height:10),
        TextField(controller:amount,keyboardType:const TextInputType.numberWithOptions(decimal:true),
          onChanged:(_)=>setState((){}),decoration:const InputDecoration(labelText:'المبلغ')),
        const SizedBox(height:10),
        Text('إجمالي المدين: ${money(value)}   •   إجمالي الدائن: ${money(value)}',
          style:const TextStyle(fontWeight:FontWeight.bold)),
        if(debitAcc.text.isNotEmpty && debitAcc.text.trim()==creditAcc.text.trim())
          const Text('يجب اختيار حسابين مختلفين',style:TextStyle(color:Colors.red)),
      ])),
      actions:[
        TextButton(onPressed:()=>Navigator.pop(ctx),child:const Text('إلغاء')),
        FilledButton(onPressed:valid?(){
          try{
            store.addJournal(store.next('MAN'),note.text.trim(),[
              JournalLine(debitAcc.text.trim(),debit:value),
              JournalLine(creditAcc.text.trim(),credit:value)]);
            Navigator.pop(ctx);
          }catch(e){ScaffoldMessenger.of(context).showSnackBar(SnackBar(content:Text('تعذر حفظ القيد: $e')));}
        }:null,child:const Text('حفظ القيد')),
      ]);
  }));
}

class CashScreen extends StatelessWidget{
  final HesabatiStore store;const CashScreen({super.key,required this.store});
  @override Widget build(BuildContext context)=>ListView(padding:const EdgeInsets.all(14),children:[
    Row(children:[Expanded(child:FilledButton.icon(onPressed:()=>cashAccountDialog(context,store),icon:const Icon(Icons.add),label:const Text('حساب نقدي / بنكي'))),const SizedBox(width:8),FilledButton.tonalIcon(onPressed:()=>transferDialog(context,store),icon:const Icon(Icons.swap_horiz),label:const Text('تحويل'))]),
    const SizedBox(height:8),Row(children:[Expanded(child:FilledButton.tonal(onPressed:()=>voucherDialog(context,store,true),child:const Text('سند قبض'))),const SizedBox(width:8),Expanded(child:FilledButton.tonal(onPressed:()=>voucherDialog(context,store,false),child:const Text('سند صرف')))]),
    const SizedBox(height:12),...store.cashAccounts.map((a)=>Card(child:ListTile(leading:CircleAvatar(child:Icon(a.type=='بنك'?Icons.account_balance:Icons.payments)),title:Text(a.name),subtitle:Text(a.type),trailing:Text('${money(a.balance)} ${store.currency}',style:const TextStyle(fontWeight:FontWeight.w900,fontSize:16)))))
  ]);
}
void voucherDialog(BuildContext context,HesabatiStore store,bool receipt){
  if(store.cashAccounts.isEmpty)return;
  String aid=store.cashAccounts.first.id;
  final other=TextEditingController(),note=TextEditingController(),amount=TextEditingController();
  showDialog(context:context,builder:(ctx)=>StatefulBuilder(builder:(ctx,setState)=>AlertDialog(
    title:Text(receipt?'سند قبض':'سند صرف'),
    content:SingleChildScrollView(child:Column(mainAxisSize:MainAxisSize.min,children:[
      DropdownButtonFormField<String>(value:aid,decoration:const InputDecoration(labelText:'الحساب النقدي / البنكي'),items:store.cashAccounts.map((a)=>DropdownMenuItem(value:a.id,child:Text(a.name))).toList(),onChanged:(v)=>setState(()=>aid=v??aid)),
      const SizedBox(height:8),TextField(controller:other,decoration:InputDecoration(labelText:'الحساب المقابل',helperText:'اختر عميلًا أو موردًا بالمعرّف، أو اكتب حسابًا عامًا',suffixIcon:PopupMenuButton<String>(icon:const Icon(Icons.people),tooltip:'اختيار عميل أو مورد',onSelected:(id)=>setState(()=>other.text=id),itemBuilder:(ctx)=>store.contacts.where((c)=>c.type==(receipt?'عميل':'مورد')).map((c)=>PopupMenuItem(value:c.id,child:Text('${c.name} (${c.id})'))).toList()))),
      const SizedBox(height:8),TextField(controller:note,decoration:const InputDecoration(labelText:'البيان')),
      const SizedBox(height:8),TextField(controller:amount,keyboardType:const TextInputType.numberWithOptions(decimal:true),onChanged:(_)=>setState((){}),decoration:const InputDecoration(labelText:'المبلغ')),
      const SizedBox(height:8),Text('رصيد الحساب: ${money(store.cash(aid)?.balance??0)} ${store.currency}'),
      if(!receipt && dval(amount.text)>(store.cash(aid)?.balance??0))const Text('الرصيد غير كافٍ',style:TextStyle(color:Colors.red)),
    ])),
    actions:[TextButton(onPressed:()=>Navigator.pop(ctx),child:const Text('إلغاء')),
      FilledButton(onPressed:dval(amount.text)<=0 || other.text.trim().isEmpty || (!receipt && dval(amount.text)>(store.cash(aid)?.balance??0))?null:(){if(store.addVoucher(receipt:receipt,cashId:aid,counterAccount:other.text,note:note.text,amount:dval(amount.text))){Navigator.pop(ctx);}else{ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content:Text('تعذر حفظ السند، تحقق من الحساب المقابل والمبلغ')));}},child:const Text('حفظ السند'))],
  )));
}
void cashAccountDialog(BuildContext context,HesabatiStore store){
  final n=TextEditingController(),o=TextEditingController(text:'0');String type='خزينة';
  showDialog(context:context,builder:(ctx)=>StatefulBuilder(builder:(ctx,setState)=>AlertDialog(title:const Text('حساب جديد'),content:Column(mainAxisSize:MainAxisSize.min,children:[
    SegmentedButton<String>(segments:const [ButtonSegment(value:'خزينة',label:Text('خزينة')),ButtonSegment(value:'بنك',label:Text('بنك'))],selected:{type},onSelectionChanged:(v)=>setState(()=>type=v.first)),const SizedBox(height:8),
    TextField(controller:n,decoration:const InputDecoration(labelText:'اسم الحساب')),const SizedBox(height:8),TextField(controller:o,keyboardType:TextInputType.number,decoration:const InputDecoration(labelText:'الرصيد الافتتاحي'))
  ]),actions:[TextButton(onPressed:()=>Navigator.pop(ctx),child:const Text('إلغاء')),FilledButton(onPressed:(){final opening=dval(o.text);if(n.text.trim().isEmpty || !opening.isFinite || opening<0 || store.cashAccounts.any((a)=>a.name==n.text.trim())){ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content:Text('أدخل اسمًا جديدًا ورصيدًا افتتاحيًا غير سالب')));return;}store.addCashAccount(n.text.trim(),type,opening);Navigator.pop(ctx);},child:const Text('حفظ'))])));
}
void transferDialog(BuildContext context,HesabatiStore store){
  if(store.cashAccounts.length<2)return;String f=store.cashAccounts[0].id,t=store.cashAccounts[1].id;final a=TextEditingController();
  showDialog(context:context,builder:(ctx)=>StatefulBuilder(builder:(ctx,setState)=>AlertDialog(title:const Text('تحويل بين الحسابات'),content:Column(mainAxisSize:MainAxisSize.min,children:[
    DropdownButtonFormField(value:f,decoration:const InputDecoration(labelText:'من'),items:store.cashAccounts.map((x)=>DropdownMenuItem(value:x.id,child:Text('${x.name} • ${money(x.balance)}'))).toList(),onChanged:(v)=>setState(()=>f=v??f)),const SizedBox(height:8),
    DropdownButtonFormField(value:t,decoration:const InputDecoration(labelText:'إلى'),items:store.cashAccounts.map((x)=>DropdownMenuItem(value:x.id,child:Text(x.name))).toList(),onChanged:(v)=>setState(()=>t=v??t)),const SizedBox(height:8),TextField(controller:a,keyboardType:TextInputType.number,decoration:const InputDecoration(labelText:'المبلغ'))
  ]),actions:[TextButton(onPressed:()=>Navigator.pop(ctx),child:const Text('إلغاء')),FilledButton(onPressed:(){if(store.transfer(f,t,dval(a.text)))Navigator.pop(ctx);},child:const Text('تحويل'))])));
}

class ExpensesScreen extends StatelessWidget{
  final HesabatiStore store;const ExpensesScreen({super.key,required this.store});
  @override Widget build(BuildContext context)=>ListView(padding:const EdgeInsets.all(14),children:[
    Row(children:[Expanded(child:FilledButton.icon(onPressed:()=>expenseDialog(context,store),icon:const Icon(Icons.add),label:const Text('تسجيل مصروف'))),const SizedBox(width:8),IconButton.filledTonal(onPressed:()=>store.exportPdfReport('المصروفات'),icon:const Icon(Icons.picture_as_pdf))]),
    const SizedBox(height:12),...store.expenses.map((e)=>Card(child:ListTile(leading:const CircleAvatar(child:Icon(Icons.payments)),title:Text(e.category),subtitle:Text('${dateText(e.date)} • ${e.note}'),trailing:Text('${money(e.amount)} ${store.currency}',style:const TextStyle(fontWeight:FontWeight.bold,color:Colors.red))))),
    if(store.expenses.isEmpty)const EmptyBox('لا توجد مصروفات بعد')
  ]);
}
