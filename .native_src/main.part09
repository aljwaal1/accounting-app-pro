n:const InputDecoration(labelText:'البيان')),const SizedBox(height:8),TextField(controller:amount,keyboardType:TextInputType.number,decoration:const InputDecoration(labelText:'المبلغ')),const SizedBox(height:8),
    DropdownButtonFormField(value:aid,decoration:const InputDecoration(labelText:'الدفع من'),items:store.cashAccounts.map((x)=>DropdownMenuItem(value:x.id,child:Text('${x.name} • ${money(x.balance)}'))).toList(),onChanged:(v)=>aid=v??aid)
  ]),actions:[TextButton(onPressed:()=>Navigator.pop(ctx),child:const Text('إلغاء')),FilledButton(onPressed:(){if(store.addExpense(cat.text.trim(),note.text.trim(),dval(amount.text),aid))Navigator.pop(ctx);},child:const Text('حفظ'))]));
}

class ReportsScreen extends StatelessWidget{
  final HesabatiStore store;const ReportsScreen({super.key,required this.store});
  @override Widget build(BuildContext context){
    final reports=[
      ('التقرير المالي الشامل','المركز المالي ومؤشرات الربحية',Icons.assessment),
      ('المبيعات','الفواتير والتحصيلات والمستحقات',Icons.receipt_long),
      ('المشتريات','فواتير الموردين والمدفوعات',Icons.local_shipping),
      ('المخزون','الكميات والتكلفة وقيمة المخزون',Icons.inventory_2),
      ('العملاء والموردون','الأرصدة والمستحقات',Icons.people),
      ('المصروفات','المصروفات حسب التصنيف والتاريخ',Icons.payments),
      ('اليومية','القيود المحاسبية المدينة والدائنة',Icons.menu_book),
      ('ميزان المراجعة','إجمالي المدين والدائن ورصيد كل حساب',Icons.balance),
      ('الخزائن والبنوك','أرصدة الحسابات النقدية والبنكية',Icons.account_balance),
    ];
    return ListView(padding:const EdgeInsets.all(14),children:[
      GridView.count(shrinkWrap:true,physics:const NeverScrollableScrollPhysics(),crossAxisCount:2,crossAxisSpacing:8,mainAxisSpacing:8,childAspectRatio:1.4,children:[
        Kpi('صافي الربح',store.netProfit,Icons.trending_up,Colors.green,store.currency),Kpi('هامش الربح',store.salesTotal==0?0:store.netProfit/store.salesTotal*100,Icons.percent,Colors.blue,'%')
      ]),
      const SizedBox(height:12),
      Card(child:Padding(padding:const EdgeInsets.all(14),child:Column(children:[
        FilledButton.icon(style:FilledButton.styleFrom(minimumSize:const Size.fromHeight(48)),onPressed:store.exportExcel,icon:const Icon(Icons.table_view),label:const Text('تصدير Excel شامل ومنسق')),
        const SizedBox(height:8),OutlinedButton.icon(style:OutlinedButton.styleFrom(minimumSize:const Size.fromHeight(48)),onPressed:store.exportBackup,icon:const Icon(Icons.backup),label:const Text('تنزيل نسخة احتياطية JSON'))
      ]))),
      const SizedBox(height:12),
      Card(child:ListTile(leading:const Icon(Icons.account_balance_wallet),title:const Text('كشف حساب تفصيلي'),subtitle:const Text('الرصيد الافتتاحي والحركات والرصيد الختامي'),onTap:()=>accountStatementDialog(context,store))),
      ...reports.map((r)=>Card(child:ListTile(leading:CircleAvatar(child:Icon(r.$3)),title:Text(r.$1),subtitle:Text(r.$2),trailing:const Icon(Icons.picture_as_pdf,color:Colors.red),onTap:()=>store.exportPdfReport(r.$1))))
    ]);
  }
}

class SettingsScreen extends StatefulWidget{final HesabatiStore store;const SettingsScreen({super.key,required this.store});@override State<SettingsScreen> createState()=>_SettingsScreenState();}
class _SettingsScreenState extends State<SettingsScreen>{
  late TextEditingController company,currency,year,fee,branch;
  @override void initState(){super.initState();final s=widget.store;company=TextEditingController(text:s.companyName);currency=TextEditingController(text:s.currency);year=TextEditingController(text:s.fiscalYear);fee=TextEditingController(text:s.feeRate.toString());branch=TextEditingController(text:s.branch);}
  @override Widget build(BuildContext context)=>ListView(padding:const EdgeInsets.all(14),children:[
    Card(child:Padding(padding:const EdgeInsets.all(14),child:Column(children:[
      TextField(controller:company,decoration:const InputDecoration(labelText:'اسم الشركة')),const SizedBox(height:10),TextField(controller:branch,decoration:const InputDecoration(labelText:'الفرع الافتراضي')),const SizedBox(height:10),
      Row(children:[Expanded(child:TextField(controller:currency,textDirection:TextDirection.ltr,decoration:const InputDecoration(labelText:'رمز العملة'))),const SizedBox(width:8),Expanded(child:TextField(controller:year,textDirection:TextDirection.ltr,keyboardType:TextInputType.number,decoration:const InputDecoration(labelText:'السنة المالية')))]),
      const SizedBox(height:10),TextField(controller:fee,textDirection:TextDirection.ltr,keyboardType:TextInputType.number,decoration:const InputDecoration(labelText:'رسوم / ضريبة اختيارية %',helperText:'إعداد حسابي عام وليس ربطًا قانونيًا مع أي دولة')),
      const SizedBox(height:14),FilledButton.icon(style:FilledButton.styleFrom(minimumSize:const Size.fromHeight(48)),onPressed:(){final rate=dval(fee.text);if(company.text.trim().isEmpty || currency.text.trim().isEmpty || year.text.trim().isEmpty || !rate.isFinite || rate<0 || rate>100){ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content:Text('تحقق من اسم الشركة والعملة والسنة المالية ونسبة الرسوم')));return;}final s=widget.store;s.companyName=company.text.trim();s.branch=branch.text.trim();s.currency=currency.text.trim();s.fiscalYear=year.text.trim();s.feeRate=rate;s.save();ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content:Text('تم حفظ الإعدادات')));},icon:const Icon(Icons.save),label:const Text('حفظ الإعدادات'))
    ]))),
    const SizedBox(height:12),
    Card(child:ListTile(leading:const Icon(Icons.info_outline),title:const Text('حساباتي Native'),subtitle:const Text('تطبيق Flutter أصلي • يعمل محليًا • لا يعتمد على صفحة ويب أو WebView')))
  ]);
}

class EmptyBox extends StatelessWidget{final String text;const EmptyBox(this.text,{super.key});@override Widget build(BuildContext context)=>Card(child:Padding(padding:const EdgeInsets.all(28),child:Center(child:Column(children:[Icon(Icons.inbox_outlined,size:42,color:Colors.grey.shade400),const SizedBox(height:8),Text(text,style:TextStyle(color:Colors.grey.shade600))]))));}

void accountStatementDialog(BuildContext context,HesabatiStore store){
  final accounts=store.journals.expand((j)=>j.lines.map((l)=>l.account)).toSet().toList()..sort();
  if(accounts.isEmpty){ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content:Text('لا توجد حسابات مسجلة')));return;}
  String selected=accounts.first;
  showDialog(context:context,builder:(ctx)=>StatefulBuilder(builder:(ctx,setLocal){
    final statement=store.accountStatement(selected);
    final summary=statement.first;
    return AlertDialog(title:const Text('كشف حساب'),content:SizedBox(width:520,height:420,child:Column(children:[
      DropdownButtonFormField<String>(initialValue:selected,isExpanded:true,decoration:const InputDecoration(labelText:'الحساب'),items:accounts.map((a)=>DropdownMenuItem(value:a,child:Text(a))).toList(),onChanged:(v){if(v!=null)setLocal(()=>selected=v);}),
      const SizedBox(height:12),Text('الرصيد الافتتاحي: ${money(summary['openingBalance'] as double)}'),
      Text('الرصيد الختامي: ${money(summary['closingBalance'] as double)}'),const Divider(),
      Expanded(child:ListView(children:statement.skip(1).map((row)=>ListTile(dense:true,title:Text('${row['note']}'),subtitle:Text('${row['ref']} • ${dateText(row['date'] as DateTime)}'),trailing:Text('مدين ${money(row['debit'] as double)} / دائن ${money(row['credit'] as double)}\nرصيد ${money(row['balance'] as double)}',textAlign:TextAlign.end))).toList()))
    ])),actions:[TextButton.icon(onPressed:()=>store.exportPdfReport('كشف حساب|$selected'),icon:const Icon(Icons.picture_as_pdf),label:const Text('تصدير PDF')),TextButton(onPressed:()=>Navigator.pop(ctx),child:const Text('إغلاق'))]);
  }));
}
